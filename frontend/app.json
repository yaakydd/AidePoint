{
  "expo": {
    "name": "AidePoint",
    "slug": "AidePoint",
    "scheme": "aidepoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-teal-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aidepoint.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AidePoint uses your camera to capture blood smear images for AI-assisted anemia screening."
      }
    },
    "android": {
      "package": "com.aidepoint.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon-teal.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#FFFFFFFF",
          "barStyle": "dark-content"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0a9cf15a-a9f5-48a3-8d01-e91fe318a055"
    },
    "extra": {
      "eas": {
        "projectId": "0a9cf15a-a9f5-48a3-8d01-e91fe318a055"
      }
    },
    "owner": "yaantwi"
  }
}
