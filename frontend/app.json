{
  "expo": {
    "name": "AidePoint",
    "slug": "AidePoint",
    "scheme": "aidepoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-teal.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aidepoint.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AidePoint uses your camera to capture blood smear images for AI-assisted anemia screening."
      }
    },
    "android": {
      "package": "com.aidepoint.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon-white.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#00CFE8"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1300091e-e1a7-4407-87eb-a92b161e97be"
    },
    "extra": {
      "eas": {
        "projectId": "1300091e-e1a7-4407-87eb-a92b161e97be"
      }
    }
  }
}